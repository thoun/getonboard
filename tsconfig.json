{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2022",
      "moduleResolution": "bundler",
      "lib": ["dom", "esnext"],  
      "sourceMap": false,
      "rootDir": "src",
      "strict": false
    },
    "include": [
        "bga-framework.d.ts",
        "src/ts/types.d.ts",
        "src/ts/**/*.d.ts",
        "src/ts/**/*.ts"
    ],
    "exclude": ["src/define.ts"]
}
